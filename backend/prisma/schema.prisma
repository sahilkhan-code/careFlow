generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// npx prisma migrate dev --name init    migration

model User{
  id         Int       @id @default(autoincrement())
  name       String    
  email      String    @unique
  createdAt  DateTime  @default(now())
}